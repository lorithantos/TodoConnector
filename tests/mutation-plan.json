{
  "configuration": "Debug",
  "mutations": [
    { "name": "auth: oid match disabled", "path": "src/TodoMcp/Auth/AllowedUser.cs",
      "find": "(oid is not null && string.Equals(a, oid, StringComparison.OrdinalIgnoreCase)) ||", "replace": "false ||" },
    { "name": "auth: empty allow-list lets everyone in", "path": "src/TodoMcp/Auth/AllowedUser.cs",
      "find": "return allowed.Any(", "replace": "return allowed.Count == 0 || allowed.Any(" },
    { "name": "auth: handler never succeeds", "path": "src/TodoMcp/Auth/AllowedUser.cs",
      "find": "context.Succeed(requirement);", "replace": "_ = requirement;" },
    { "name": "auth: /mcp not protected", "path": "src/TodoMcp/Program.cs",
      "find": "app.MapMcp(\"/mcp\").RequireAuthorization(AllowedUserCheck.PolicyName);", "replace": "app.MapMcp(\"/mcp\");" },
    { "name": "facade: 401 challenge header missing", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "ctx.Request.Path.StartsWithSegments(\"/mcp\"))", "replace": "ctx.Request.Path.StartsWithSegments(\"/nope\"))" },
    { "name": "facade: redirect allow-list accepts anything", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "!string.IsNullOrEmpty(uri) && options.AllowedRedirectUris.Contains(uri, StringComparer.Ordinal);", "replace": "!string.IsNullOrEmpty(uri);" },
    { "name": "clock: due dates sent with IANA id, not Windows", "path": "src/TodoMcp/Todo/TodoClock.cs",
      "find": "            ? windows", "replace": "            ? options.CurrentValue.TimeZone" },
    { "name": "clock: ToLocal ignores the source zone", "path": "src/TodoMcp/Todo/TodoClock.cs",
      "find": "TimeZoneInfo.ConvertTime(unspecified, sourceZone, this.Zone)", "replace": "TimeZoneInfo.ConvertTime(unspecified, this.Zone, this.Zone)" },
    { "name": "agenda: completed tasks included", "path": "src/TodoMcp/Todo/TaskViews.cs",
      "find": ".Where(x => !x.Task.IsCompleted)", "replace": ".Where(x => true)" },
    { "name": "agenda: no upcoming horizon", "path": "src/TodoMcp/Todo/TaskViews.cs",
      "find": "else if (d <= horizon)", "replace": "else if (true)" },
    { "name": "graph: completed filter inverted", "path": "src/TodoMcp/Todo/GraphTodoClient.cs",
      "find": "if (!includeCompleted)", "replace": "if (includeCompleted)" },

    { "name": "B1 facade: authorize accepts a non-S256 challenge method", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "if (string.IsNullOrEmpty(q[\"code_challenge\"]) || q[\"code_challenge_method\"] != \"S256\")", "replace": "if (string.IsNullOrEmpty(q[\"code_challenge\"]))" },
    { "name": "B1 facade: authorize accepts a missing code_challenge", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "if (string.IsNullOrEmpty(q[\"code_challenge\"]) || q[\"code_challenge_method\"] != \"S256\")", "replace": "if (q[\"code_challenge_method\"] != \"S256\")" },
    { "name": "B2 facade: authorize does not check response_type", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "if (q[\"response_type\"] != \"code\")", "replace": "if (false)" },
    { "name": "B3 facade: code exchange skips the redirect allow-list", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "|| !IsAllowedRedirect(redirect, options))", "replace": ")" },
    { "name": "B4 facade: refresh token not relayed", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "form[\"refresh_token\"] = refresh;", "replace": "form[\"refresh_tokn\"] = refresh;" },
    { "name": "B4 facade: refresh grant without a refresh_token accepted", "path": "src/TodoMcp/Auth/OAuthFacade.cs",
      "find": "if (!incoming.TryGetValue(\"refresh_token\", out string? refresh) || string.IsNullOrEmpty(refresh))", "replace": "if (!incoming.TryGetValue(\"refresh_token\", out string? refresh) && false)" },
    { "name": "B5 agenda: past reminders shown as coming up", "path": "src/TodoMcp/Todo/TaskViews.cs",
      "find": "r >= now && r <= reminderHorizon", "replace": "r <= reminderHorizon" },
    { "name": "B6 agenda: important bucket ignores the due date", "path": "src/TodoMcp/Todo/TaskViews.cs",
      "find": "else if (string.Equals(task.Importance, \"high\", StringComparison.OrdinalIgnoreCase))", "replace": "if (string.Equals(task.Importance, \"high\", StringComparison.OrdinalIgnoreCase))" },
    { "name": "B7 graph: paging stops after the first page", "path": "src/TodoMcp/Todo/GraphTodoClient.cs",
      "find": "next = page.NextLink;", "replace": "next = null;" },
    { "name": "B7 graph: paging ignores max", "path": "src/TodoMcp/Todo/GraphTodoClient.cs",
      "find": "while (next is not null && results.Count < max)", "replace": "while (next is not null)" },
    { "name": "B7 graph: results not trimmed to max", "path": "src/TodoMcp/Todo/GraphTodoClient.cs",
      "find": "return results.Count > max ? results[..max] : results;", "replace": "return results;" },
    { "name": "B8 tools: complete_task sends the wrong status", "path": "src/TodoMcp/Tools/TodoTools.cs",
      "find": "new { status = \"completed\" }", "replace": "new { status = \"notStarted\" }" },
    { "name": "B9 tools: clear_reminder leaves the reminder time", "path": "src/TodoMcp/Tools/TodoTools.cs",
      "find": "patch[\"reminderDateTime\"] = null;", "replace": "patch[\"reminderDateTim\"] = null;" },
    { "name": "B9 tools: clear_reminder leaves the reminder on", "path": "src/TodoMcp/Tools/TodoTools.cs",
      "find": "patch[\"isReminderOn\"] = false;", "replace": "patch[\"isReminderOn\"] = true;" },
    { "name": "B10 tools: Graph errors not translated", "path": "src/TodoMcp/Tools/TodoTools.cs",
      "find": "catch (GraphRequestException e) { throw new McpException(e.Message); }", "replace": "catch (GraphRequestException) { throw; }" },
    { "name": "B11 tools: importance not validated", "path": "src/TodoMcp/Tools/TodoTools.cs",
      "find": "_ => throw new ArgumentException(\"importance must be low, normal or high.\"),", "replace": "_ => value," }
  ]
}
